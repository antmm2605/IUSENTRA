      "tests": ["tests/legal_deposit/test_penal_deposit_rules.py", "tests/legal_deposit/test_payment_policies.py"],
      "limits": ["NRG e UID del Portale Avvocato non sono codici ufficio PST."]
    },
    {
      "id": "ptt_sigit_profilo_cut",
      "source_ids": ["ptt_assistenza", "ptt_processo", "ptt_pagamenti", "ptt_area_video", "ptt_cut_circolare_2019", "sigit_home"],
      "rule": "PTT/SIGIT è canale autonomo; CUT pagoPA si collega a RGR/RGA da PEC o area personale PTT con abbinamento al ricorso/appello.",
