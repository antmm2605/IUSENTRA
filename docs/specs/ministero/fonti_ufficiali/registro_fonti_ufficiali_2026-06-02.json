  "rules": [
    {
      "id": "cu_art13_calcolo_base",
      "source_ids": ["dpr_115_art13_def", "normattiva_dpr_115"],
      "rule": "Il contributo unificato civile usa gli scaglioni dell'art. 13, comma 1, DPR 115/2002; il valore indeterminabile e il valore non indicato hanno importi propri.",
      "software_modules": ["pct/normative_tables.py", "pct/strumenti_legali.py"],
      "tests": ["tests/test_strumenti_legali.py"],
      "limits": ["Esenzioni e casi speciali non ricavabili dai soli dati inseriti devono restare come avvisi professionali."]
    },
    {
      "id": "cu_art13_riduzioni_50",
      "source_ids": ["dpr_115_art13_def"],
      "rule": "Decreto ingiuntivo, lavoro/pubblico impiego e processi speciali libro IV titolo I c.p.c. sono ridotti alla metà; gli altri processi esecutivi sono ridotti alla metà rispetto all'esecuzione immobiliare.",
      "software_modules": ["pct/strumenti_legali.py"],
      "tests": ["tests/test_strumenti_legali.py"],
      "limits": ["La riduzione viene applicata solo alle categorie dichiarate; se la categoria reale non è selezionata il software non può inferirla con certezza."]
    },
    {
      "id": "cu_art13_maggiorazioni",
      "source_ids": ["dpr_115_art13_def"],
      "rule": "Impugnazione +50%, Cassazione x2, sezioni specializzate impresa x2, dati obbligatori mancanti +50%.",
      "software_modules": ["pct/strumenti_legali.py", "pct/applicazioni_runtime.py", "web/templates/strumenti_legali/index.html"],
      "tests": ["tests/test_strumenti_legali.py"],
      "limits": ["Il raddoppio sezione impresa viene applicato automaticamente solo al civile ordinario; per altri canali serve verifica puntuale."]
    },
    {
      "id": "cu_art13_importi_speciali",
      "source_ids": ["dpr_115_art13_def"],
      "rule": "Art. 13 disciplina importi speciali per ricerca beni ex art. 492-bis, cittadinanza italiana, esecuzioni, opposizione atti esecutivi, procedura fallimentare, amministrativo e tributario.",
      "software_modules": ["pct/normative_tables.py", "pct/strumenti_legali.py"],
      "tests": ["tests/test_strumenti_legali.py"],
      "limits": ["Per cittadinanza italiana il software calcola 600 euro per ciascun ricorrente e non applica automatismi sul grado senza fonte specifica."]
    },
    {
      "id": "pst_uffici_codici_deposito",
      "source_ids": ["pst_uffici_civili", "pst_uffici_penali", "pst_servizi_web_v169", "pst_documentation"],
      "rule": "Codici e uffici civili e penali del PST sono cataloghi separati; il codice civile non è intercambiabile con il codice penale/PDP.",
      "software_modules": ["pct/uffici_giudiziari.py", "pct/uffici_competenti.py", "pct/polisWeb.py", "legal_deposit/policies.py"],
      "tests": ["tests/test_uffici_giudiziari_comuni_db.py", "tests/test_polisweb.py", "tests/test_local_signer.py"],
      "limits": ["Le voci storiche o non operative restano consultabili per codice esatto ma non selezionate automaticamente per nome."]
    },
    {
      "id": "pst_schemi_canali",
      "source_ids": ["pst_pdp_penale", "pst_cassazione_xsd", "pst_sigp_xsd", "pst_unep_codici", "pst_unep_xsd", "pst_download"],
      "rule": "PDP penale, Cassazione, SIGP e UNEP hanno canali e schemi propri; non devono essere normalizzati come SICID generico.",
      "software_modules": ["legal_deposit/policies.py", "pct/polisWeb.py", "pct/pec_legal_workflow.py"],
      "tests": ["tests/test_portali_telematici_matrix.py", "tests/test_pec_legal_workflow.py", "tests/test_local_signer.py"],
      "limits": ["Dove la fonte pubblica non espone un codice depositabile dedicato, il software deve avvisare e non sostituire il codice."]
    },
    {
      "id": "notifiche_pec_catena_probatoria",
      "source_ids": ["pst_specifiche_dm44_2024", "normattiva_legge_53_1994", "normattiva_dpr_68_2005_pec", "normattiva_cad_art48", "gazzetta_dm_pec_2005"],
      "rule": "Gli stati PROOF_ACQUIRED, PROOF_DEPOSIT_REQUIRED e PROOF_DEPOSITED non dipendono dalla sola presenza di proof_bundle_id: richiedono destinatario, domicilio digitale/fonte, messaggio PEC originale, relata verificata, ricevuta di accettazione e ricevuta di avvenuta consegna per ogni destinatario, evidenze hashate e bundle probatorio verificato.",
      "software_modules": ["pct/notification_proof_matrix.py", "pct/procedure_lifecycle_repository.py", "pct/notification_workflow.py"],
      "tests": ["tests/test_notification_workflow.py", "tests/test_evidence_vault.py", "tests/test_procedure_lifecycle_edges.py", "tests/test_procedure_lifecycle_repository.py"],
      "limits": ["Il software non invia PEC reali e non qualifica il perfezionamento in assenza di RAC/RdAC verificate; anomalie, mancate accettazioni e mancate consegne bloccano la prova positiva e richiedono remediation professionale."]
    },
    {
      "id": "notifiche_domicilio_digitale_per_destinatario",
      "source_ids": ["pst_reginde", "registroimprese_inipec", "mimit_inipec_pec", "agid_inad", "normattiva_legge_53_1994"],
      "rule": "Ogni destinatario deve avere indirizzo, fonte del domicilio digitale e stato autonomi; ReGIndE, INI-PEC e INAD sono fonti distinte e la fonte manuale richiede review tracciata prima dello stato READY.",
      "software_modules": ["pct/notification_proof_matrix.py", "pct/procedure_lifecycle_repository.py", "pct/notification_workflow.py"],
      "tests": ["tests/test_notification_workflow.py", "tests/test_procedure_lifecycle_edges.py"],
      "limits": ["La ricerca o selezione della fonte non autorizza scraping massivo; se il pubblico elenco non è certo il flusso resta in NEEDS_REVIEW o remediation, non in READY automatico."]
    },
    {
      "id": "notifiche_unep_richiesta_relata_ricevute",
      "source_ids": ["pst_specifiche_dm44_2024", "pst_unep_xsd", "pst_reginde", "registroimprese_inipec", "agid_inad"],
      "rule": "Per notifiche UNEP la richiesta di parte usa il canale e gli schemi UNEP/RichiestaParte; la prova positiva richiede relazione di notificazione firmata o qualificata congiunta all'atto e ricevute PEC collegate al destinatario.",
      "software_modules": ["pct/notification_proof_matrix.py", "pct/procedure_lifecycle_repository.py"],
      "tests": ["tests/test_procedure_lifecycle_edges.py"],
      "limits": ["La matrice runtime è predisposta per NOTIFICA_UNEP ma non sostituisce l'integrazione reale UNEP: senza schema, ricevute e relazione effettive il software avvisa e non chiude la prova."]
    },
    {
      "id": "notifiche_deposito_prova_dati_atto",
      "source_ids": ["pst_specifiche_dm44_2024", "pst_download", "normattiva_legge_53_1994"],
      "rule": "Il deposito della prova di notifica richiede atto notificato, relata, PEC inviata, RAC, RdAC, DatiAtto.xml, busta di deposito prova, ricevuta di deposito e esito ufficio; i riferimenti DatiAtto alle ricevute sono registrati per destinatario e per ricevuta.",
      "software_modules": ["pct/notification_proof_matrix.py", "pct/notification_workflow.py", "pct/procedure_lifecycle_repository.py"],
      "tests": ["tests/test_notification_workflow.py", "tests/test_procedure_lifecycle_edges.py"],
      "limits": ["PROOF_DEPOSITED è ammesso solo con deposito prova OFFICE_ACCEPTED; la sola ricevuta PEC di invio o un generico documento nel vault non basta."]
    },
    {
      "id": "pst_pagamenti_rt_xml",
      "source_ids": ["pst_pagamenti_scheda", "pst_pagamenti_wisp", "pst_webservices_pagamenti", "pst_pagopa_pubblico", "pst_vademecum_pagamenti", "pst_flussi_pagamento_v63"],
      "rule": "Per PCT/PST la prova tecnica del pagamento telematico è RT.xml; il promemoria PDF non sostituisce la RT. Codici governati: CONTRIB, DIRCANC, DIRCOPIA, CONTRBENI, UNPIG, UNNOT.",
      "software_modules": ["legal_deposit/payment_policies.py", "pct/deposito_guidato.py"],
      "tests": ["tests/legal_deposit/test_payment_policies.py", "tests/test_deposito_guidato.py"],
      "limits": ["Il software non fa polling continuo e non considera il promemoria PDF come ricevuta tecnica sostitutiva."]
    },
    {
      "id": "pat_siga_profilo_pagamenti",
      "source_ids": ["pat_portale_avvocato", "pat_processo_amministrativo", "pat_faq", "pat_f24_elide"],
      "rule": "PAT/SIGA è canale autonomo; il contributo unificato amministrativo viene tracciato con F24 Elide e quietanza, non con codici ufficio PST.",
