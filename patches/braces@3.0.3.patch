+'use strict';
+
+module.exports = depth => {
+  if (depth > 128) {
+    const error = new RangeError('Brace pattern structural depth exceeds safe limit (128)');
+    error.code = 'ERR_BRACES_DEPTH_LIMIT';
+    throw error;
+  }
+};
