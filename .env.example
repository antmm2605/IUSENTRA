# =============================================================================
#  IUSENTRA | Configurazione ambiente
#
#  Copia questo file in  .env  e modifica i valori:
#    cp .env.example .env          (Linux / Mac)
#    copy .env.example .env        (Windows CMD)
#
#  Il file .env NON deve essere committato nel repository (è in .gitignore).
# =============================================================================


# =============================================================================
#  OBBLIGATORIO — chiave segreta sessioni Flask
#  Genera con:  python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================
PCT_SECRET_KEY=

# Password temporanea bootstrap admin (opzionale).
# Se lasciata vuota, IUSENTRA genera una password casuale al primo avvio
# e la salva in ./data/auth/bootstrap_admin.json da cambiare subito al primo accesso.
# PCT_BOOTSTRAP_ADMIN_PASSWORD=


# =============================================================================
#  Porta locale (default 8080 → http://localhost:8080)
# =============================================================================
HACS_PORT=8080


# =============================================================================
#  Dati generali studio (usati in PDF, intestazioni, template atti)
# =============================================================================
PCT_STUDIO_NOME=IUSENTRA
PCT_STUDIO_PIVA=
PCT_STUDIO_CF=
PCT_STUDIO_INDIRIZZO=
PCT_STUDIO_IBAN=
PCT_STUDIO_AVVOCATO=


# =============================================================================
#  Multi-tenant (1 = abilitato, pannello admin su /admin/)
# =============================================================================
PCT_MULTI_TENANT=1


# =============================================================================
#  Cifratura documenti su disco — opzionale ma consigliata in produzione
#  Genera con:  python -c "import secrets; print(secrets.token_hex(32))"
#  ATTENZIONE: se perdi questa chiave, i documenti cifrati NON sono recuperabili!
# =============================================================================
# PCT_DOC_KEY=


# =============================================================================
#  PEC — Posta Elettronica Certificata
# =============================================================================
# PCT_PEC_INDIRIZZO=studiolegale@pec.aruba.it
# PCT_PEC_PASSWORD=password_pec
# PCT_PEC_SMTP_HOST=smtp.pec.aruba.it
# PCT_PEC_SMTP_PORT=465
# PCT_PEC_IMAP_HOST=imaps.pec.aruba.it


# =============================================================================
#  Firma Digitale (file PKCS#12 / smart card)
# =============================================================================
# PCT_FIRMA_P12=/data/firma.p12
# PCT_FIRMA_PASSWORD=password_firma
# PCT_CF_AVVOCATO=RSSMRA80A01H501Z
# Opzionale: su Windows il probing PKCS#11 e' passivo di default per evitare
# crash dei middleware durante i controlli di disponibilita'. Imposta a 1 solo
# per diagnostica esplicita del token.
# PCT_PKCS11_ACTIVE_PROBE=0
# PCT_NOME_AVVOCATO=Avv. Mario Rossi
# PST consultazione:
# - IUSENTRA puo' comporre automaticamente il proxy completo partendo dal codice ufficio
#   se il registro ministeriale interno contiene codice GL e servizio JPW.
# - Facoltativamente si puo' impostare solo il root proxy:
#     PCT_PST_BASE_URL=https://ext.processotelematico.giustizia.it
# - Oppure il proxy completo fornito dal proprio PdA/software house:
#     PCT_PST_BASE_URL=https://ext.processotelematico.giustizia.it/pda/pycons/GLMI/JPW_SICID
# - Override opzionali:
#     PCT_PST_PROXY_ROOT=https://pda.processotelematico.giustizia.it
#     PCT_PST_SERVIZIO_DEFAULT=JPW_SICID
#     Per Cassazione usare JPW_CASSCI (civile) oppure JPW_CASSPE (penale)
# L'endpoint storico https://wspa.giustizia.it/wspa e' legacy e non va piu' usato come default.


# =============================================================================
#  Email / SMTP — per notifiche e reset password
# =============================================================================
# PCT_SMTP_HOST=smtp.gmail.com
# PCT_SMTP_PORT=587
# PCT_SMTP_USER=tuo@gmail.com
# PCT_SMTP_PASS=app-password-gmail
# PCT_SMTP_FROM=tuo@gmail.com


# =============================================================================
#  API v1 — CORS cross-origin
# =============================================================================
# Lascia vuoto per non esporre l'API a origin esterni.
# Se serve una app mobile o frontend separato, elenca gli origin ammessi separati da virgola.
# PCT_API_V1_ALLOWED_ORIGINS=https://app.example.it,https://mobile.example.it


# =============================================================================
#  WhatsApp / SMS via Twilio
# =============================================================================
# PCT_TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PCT_TWILIO_TOKEN=your_auth_token
# PCT_TWILIO_NUMERO=+39XXXXXXXXXX
# TWILIO_WA_NUMBER=whatsapp:+14155238886


# =============================================================================
#  Backup e promemoria automatici
# =============================================================================
PCT_BACKUP_ORA=02:00
PCT_WA_REMINDER_ORA=18:00

# =============================================================================
#  Impostazioni Studio — configurazione persistente
# =============================================================================
# Percorso del file JSON con tutta la configurazione dello studio (PEC, SMTP,
# firma, WhatsApp, scheduler). Modificabile dalla UI in /impostazioni.
# Se non impostato, usa ./config/studio.json (o /data/config/studio.json in Docker).
# PCT_STUDIO_CONFIG=/data/config/studio.json

# -----------------------------------------------------------------------------
#  AI locale / Ollama
# -----------------------------------------------------------------------------
# In Docker su Windows o macOS, la strategia consigliata e' usare Ollama nativo
# sull'host e collegarlo dal container tramite host.docker.internal.
# PCT_LOCAL_AI_BASE_URL=http://host.docker.internal:11434/api
# Il sidecar Docker "ollama" resta disponibile come profilo opzionale:
# docker compose --profile ollama-sidecar up -d

