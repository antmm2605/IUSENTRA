      "human_review_required": true,
      "notification_case": "explicit_order",
      "result_priority": "P1",
      "legal_sources": ["src.it.l53_1994.art3bis", "src.it.cpc.arts137_149"],
      "portal_original": "conditional"
    },
    {
      "id": "notif.detect.judgment_to_notify_review.v1",
      "priority": 675,
      "source_types": ["message_body", "attachment", "validation_report"],
      "positive_any": [
        "sentenza\\s+a\\s+verbale",
        "decide\\s+la\\s+causa\\s+con\\s+sentenza",
        "sentenza.{0,260}(?:definitivamente\\s+decidendo|condanna|accerta|rigetta|accoglie|liquida)",
        "(?:definitivamente\\s+decidendo|condanna|accerta|rigetta|accoglie|liquida).{0,260}sentenza"
