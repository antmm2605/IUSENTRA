{
	email {$ACME_EMAIL}
}

{$IUSENTRA_DOMAIN} {
	encode zstd gzip

	log {
		output file /var/log/iusentra/caddy-access.log {
			roll_size 50mb
			roll_keep 7
		}
		format json
	}

	request_body {
		max_size 200MB
	}

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	@default_permissions {
		not path /support/join/* /support/operatore/*
	}
	header @default_permissions Permissions-Policy "camera=(self), microphone=(self), local-network-access=(), local-network=(), loopback-network=(), geolocation=()"

	# Rate limiting sulle route di autenticazione gestito da Flask-Limiter
	# con backend Redis (RATELIMIT_STORAGE_URI=redis://redis:6379/1).
	# Il modulo caddy-ratelimit non è incluso in caddy:2.8-alpine standard;
	# per aggiungere rate limiting a livello reverse proxy usare un'immagine
	# xcaddy custom oppure affidarsi al layer Flask (già operativo).

	@static path /static/*
	header @static Cache-Control "public, max-age=604800"

	@react_shell path /app-v2*
	header @react_shell Cache-Control "no-store, no-cache, must-revalidate, max-age=0"

	@support_rooms path /support/join/* /support/operatore/*
	header @support_rooms Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), local-network-access=(self), local-network=(self), loopback-network=(self), geolocation=(), payment=()"

	@sw path /sw.js /static/sw.js
	header @sw Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
	header @sw Service-Worker-Allowed "/"

	# SSE — timeout lungo, nessun buffering
	@sse path /api/eventi
	reverse_proxy @sse app:8080 {
		flush_interval -1
		transport http {
			read_timeout 1h
			write_timeout 1h
		}
	}

	# WebSocket supporto remoto
	@support_ws path /support/ws/*
	reverse_proxy @support_ws app:8080 {
		flush_interval -1
		transport http {
			read_timeout 1h
			write_timeout 1h
		}
	}

	reverse_proxy app:8080 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		health_uri /api/pronto
		health_interval 30s
		health_timeout 5s
	}
}
