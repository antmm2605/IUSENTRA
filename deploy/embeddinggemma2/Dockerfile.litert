FROM python:3.12-slim@sha256:05cda9777409a9c3ffddd94a4c476b79f0769a0b4857f0c7ed9226b6800b0d6f
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    IUSENTRA_EMBEDDING_RUNTIME=litert IUSENTRA_EMBEDDING_BIND=0.0.0.0 \
    IUSENTRA_EMBEDDING_MODEL_DIR=/models
WORKDIR /srv
RUN pip install --no-cache-dir litert-lm==0.18.0
COPY pct/__init__.py pct/embeddinggemma2.py ./pct/
COPY deploy/embeddinggemma2/server.py deploy/embeddinggemma2/litert_encoder.py \
    deploy/embeddinggemma2/litert-model-manifest.json ./
USER 65534:65534
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:11140/health',timeout=3)"
CMD ["python", "server.py"]
