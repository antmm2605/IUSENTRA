diff --git a/frontend/src/components/RedazioneAttiPage.css b/frontend/src/components/RedazioneAttiPage.css
new file mode 100644
index 00000000..484824cf
--- /dev/null
+++ b/frontend/src/components/RedazioneAttiPage.css
@@ -0,0 +1,145 @@
+@import '../theme/impeccable-open-design.css';
+
+.iu-redazione-page {
+  color: var(--iu-od-text);
+}
+
+.iu-redazione-contract {
+  align-items: center;
+  display: flex;
+  gap: var(--iu-od-space-3);
+  padding: var(--iu-od-space-3) var(--iu-od-space-4);
+}
+
+.iu-redazione-contract strong,
+.iu-redazione-contract span {
+  display: block;
+}
+
+.iu-redazione-contract span,
+.iu-redazione-hero p,
+.iu-redazione-row span,
+.iu-redazione-record span,
+.iu-redazione-record small,
+.iu-redazione-guard p,
+.iu-redazione-source {
+  color: var(--iu-od-muted);
+}
+
+.iu-redazione-warnings,
+.iu-redazione-list,
+.iu-redazione-records {
+  display: grid;
+  gap: var(--iu-od-space-3);
+}
+
+.iu-redazione-warning {
+  margin: 0;
+  padding: var(--iu-od-space-3) var(--iu-od-space-4);
+}
+
+.iu-redazione-metrics {
+  display: grid;
+  gap: var(--iu-od-doc-gap);
+  grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
+}
+
+.iu-redazione-hero {
+  align-items: start;
+  display: grid;
+  gap: var(--iu-od-doc-section-gap);
+  grid-template-columns: minmax(0, 1fr) auto;
+  padding: var(--iu-od-space-6);
+}
+
+.iu-redazione-hero h2 {
+  font-size: 1.55rem;
+  line-height: 1.2;
+  margin: var(--iu-od-space-2) 0;
+}
+
+.iu-redazione-hero p,
+.iu-redazione-guard p {
+  line-height: 1.65;
+  margin: 0;
+  max-width: 72ch;
+}
+
+.iu-redazione-eyebrow {
+  color: var(--iu-od-muted);
+  font-size: 0.78rem;
+  font-weight: 700;
+  letter-spacing: 0;
+  margin: 0;
+  text-transform: uppercase;
+}
+
+.iu-redazione-hero__actions {
+  justify-content: flex-end;
+}
+
+.iu-redazione-section-grid {
+  display: grid;
+  gap: var(--iu-od-doc-gap);
+  grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
+}
+
+.iu-redazione-row,
+.iu-redazione-record {
+  align-items: center;
+  border: 1px solid var(--iu-od-border);
+  border-radius: var(--iu-od-doc-card-radius);
+  display: flex;
+  gap: var(--iu-od-space-3);
+  justify-content: space-between;
+  padding: var(--iu-od-space-3);
+  text-decoration: none;
+  transition: border-color var(--iu-od-transition), box-shadow var(--iu-od-transition);
+}
+
+.iu-redazione-record:hover {
+  border-color: var(--iu-od-focus);
+  box-shadow: var(--iu-od-shadow-1);
+}
+
+.iu-redazione-row strong,
+.iu-redazione-record strong {
+  color: var(--iu-od-text);
+  display: block;
+}
+
+.iu-redazione-row span,
+.iu-redazione-record span,
+.iu-redazione-record small {
+  display: block;
+  line-height: 1.45;
+}
+
+.iu-redazione-guard {
+  align-items: start;
+  display: flex;
+  gap: var(--iu-od-space-3);
+  padding: var(--iu-od-space-4);
+}
+
+.iu-redazione-guard h2 {
+  font-size: 1.1rem;
+  margin: 0 0 var(--iu-od-space-2);
+}
+
+@media (max-width: 820px) {
+  .iu-redazione-hero {
+    grid-template-columns: 1fr;
+  }
+
+  .iu-redazione-hero__actions {
+    justify-content: flex-start;
+  }
+
+  .iu-redazione-guard,
+  .iu-redazione-row,
+  .iu-redazione-record {
+    align-items: flex-start;
+    flex-direction: column;
+  }
+}

diff --git a/frontend/src/components/RedazioneAttiPage.tsx b/frontend/src/components/RedazioneAttiPage.tsx
