<?xml version="1.0" encoding="UTF-8"?>
<catalog>
	<class name="Giudice">
		<property name="denominazione" type="string" description="cognome e nome giudice"/>
	</class>
	<class name="InfoCC">
		<property name="nome" type="string" description="nome curatore/commissario/delegato"/>
		<property name="cognome" type="string" description="cognome curatore/commissario/delegato"/>
		<property name="tipologia" type="string" description="tipologia curatore/commissario/delegato"/>
	</class>
	<class name="Parti">
		<property name="nome" type="string" description="nome parte"/>
		<property name="cognome" type="string" description="cognome parte"/>
		<property name="desctipo" type="string" description="descrizione parte"/>
		<property name="codicefiscale" type="string" description="codice fiscale parte"/>
		<property name="avvocato" type="string" description="avvocato della parte"/>
	</class>
	<class name="Storico">
		<property name="descevento" type="string" description="descrizione evento"/>
		<property name="dataevento" type="date" description="data evento"/>
