        "(?:art\\.?\\s*429|429\\s*c\\.?p\\.?c\\.?).{0,220}sentenza.{0,260}(?:definitivamente\\s+decidendo|condanna|accerta|rigetta|accoglie|liquida)",
        "sentenza.{0,260}p\\.q\\.m\\..{0,260}(?:condanna|accerta|rigetta|accoglie|liquida)",
        "definitivamente\\s+decidendo.{0,260}(?:condanna|accerta|rigetta|accoglie|liquida).{0,260}sentenza"
