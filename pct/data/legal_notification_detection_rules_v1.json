  "detection_rules": [
    {
      "id": "notif.detect.comunicazione_xml_office_negative.v1",
      "priority": 1000,
      "source_types": ["comunicazione_xml"],
      "positive_any": ["notificat[oa]\\s+alla\\s+pec", "notificat[oa]\\s+in\\s+cancelleria"],
      "negative_any": [],
      "event_type": "office_communication_not_l53_notification",
      "confidence": 0.99,
      "reason": "La formula di Comunicazione.xml descrive l'attività dell'ufficio e non prova una notifica dell'avvocato alla controparte.",
      "proposed_action": "Conservare come comunicazione d'ufficio; non creare prova di notifica L. 53/1994.",
      "creates_notification_candidate": false,
      "human_review_required": false,
      "notification_case": "office_communication",
      "result_priority": "P2",
      "legal_sources": ["src.it.dgsia.technical_rules_2024.bundle"],
      "portal_original": "conditional",
      "terminal_for_source": true
    },
    {
      "id": "notif.receipt.delivery_failure.v1",
      "priority": 900,
      "source_types": ["message_subject", "message_body", "daticert_xml", "eml", "attachment"],
      "positive_any": ["avviso\\s+di\\s+mancata\\s+consegna", "mancata\\s+consegna", "delivery\\s+failure"],
      "negative_any": ["fac[- ]?simile", "esempio"],
      "event_type": "notification_delivery_failure",
      "confidence": 0.96,
      "reason": "È presente un avviso di mancata consegna da collegare alla notifica e alla causa dell'insuccesso.",
      "proposed_action": "Aprire revisione urgente e valutare il percorso art. 3-ter soltanto se ne ricorrono i presupposti.",
      "creates_notification_candidate": true,
      "human_review_required": true,
      "notification_case": "delivery_failure",
      "result_priority": "P0",
      "legal_sources": ["src.it.l53_1994.art3ter", "src.it.dpr68_2005.art6_8"],
      "portal_original": "conditional"
    },
    {
      "id": "notif.receipt.rdac_complete.v1",
      "priority": 850,
      "source_types": ["message_subject", "message_body", "daticert_xml", "eml", "attachment"],
      "positive_any": ["ricevuta\\s+completa\\s+di\\s+avvenuta\\s+consegna", "ricevuta\\s+di\\s+avvenuta\\s+consegna"],
      "negative_any": ["fac[- ]?simile", "esempio"],
      "event_type": "notification_rdac",
      "confidence": 0.97,
      "reason": "La RdAC è evidenza della consegna e determina l'effetto per il destinatario secondo il regime applicabile.",
      "proposed_action": "Collegare la RdAC alla PEC inviata e alla RAC, verificando destinatario e timestamp effettivo.",
      "creates_notification_candidate": true,
      "human_review_required": true,
      "notification_case": "delivery_receipt",
      "result_priority": "P1",
      "legal_sources": ["src.it.l53_1994.art3bis", "src.it.cpc.art147", "src.it.dpr68_2005.art6_8", "src.it.dm44_2011.art18"],
      "portal_original": "never"
    },
    {
      "id": "notif.receipt.rac.v1",
      "priority": 840,
      "source_types": ["message_subject", "message_body", "daticert_xml", "eml", "attachment"],
      "positive_any": ["ricevuta\\s+di\\s+accettazione"],
      "negative_any": ["fac[- ]?simile", "esempio"],
      "event_type": "notification_rac",
