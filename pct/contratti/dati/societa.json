  "rif": [
   "artt. 2469-2470 c.c."
  ],
  "forma": "scrittura_autenticata",
  "note": "Deposito al registro imprese tramite notaio o intermediario abilitato (art. 36, comma 1-bis, D.L. 112/2008).",
  "clausole": [
   "oggetto",
   "quote_prezzo",
   "pagamento",
   "quote_condizioni",
   "quote_garanzie",
   "riservatezza",
   "comunicazioni",
   "legge_foro",
   "spese_contratto"
  ],
  "domande": [
   {
    "id": "prelazione_statutaria",
    "testo": "Lo statuto prevede prelazione o gradimento?"
   },
   {
    "id": "cedente_coniugato_comunione",
    "testo": "Il cedente è coniugato in comunione legale?"
   },
   {
    "id": "due_diligence",
    "testo": "È stata svolta una due diligence?"
   },
   {
    "id": "quote_pegno",
    "testo": "Le quote sono gravate da pegno o vincoli?"
   }
  ],
  "controlli": [
   {
    "id": "prelazione",
    "quando": {
     "prelazione_statutaria": true
    },
    "esito": "adempimento",
    "messaggio": "Esperire la procedura statutaria di prelazione o gradimento prima del trasferimento.",
    "norma": "art. 2469 c.c."
   },
   {
    "id": "comunione",
    "quando": {
     "cedente_coniugato_comunione": true
    },
    "esito": "valutazione_avvocato",
    "messaggio": "Verificare se le quote ricadono in comunione legale e acquisire il consenso del coniuge.",
    "norma": "artt. 177, 180 c.c."
   },
   {
    "id": "dd",
    "quando": {
     "due_diligence": false
    },
    "esito": "valutazione_avvocato",
    "messaggio": "Senza due diligence rafforzare dichiarazioni, garanzie e indennizzi.",
    "norma": "art. 1322 c.c."
   },
   {
    "id": "vincoli_quote",
    "quando": {
     "quote_pegno": true
    },
    "esito": "blocco",
    "messaggio": "Liberare le quote o ottenere il consenso del creditore pignoratizio.",
    "norma": "artt. 2471-bis, 2784 c.c."
   },
   {
    "id": "deposito_ri",
    "quando": {},
    "esito": "adempimento",
    "messaggio": "Deposito al registro imprese entro 30 giorni tramite notaio o intermediario abilitato.",
    "norma": "art. 2470 c.c.; art. 36 D.L. 112/2008"
   }
  ]
 },
