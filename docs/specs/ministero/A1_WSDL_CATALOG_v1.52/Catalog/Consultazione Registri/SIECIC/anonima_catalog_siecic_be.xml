		<property name="stato" type="string" description="stato del fascicolo"/>
		<property name="dataProssimaUdienzaPassivo" type="string" description="data prossima udienza di verifica passivo"/>
		<property name="dataProssimaUdienzaVendita" type="date" description="data prossima udienza di vendita"/>
		<property name="debitore" type="string" description="nome del debitore"/>
