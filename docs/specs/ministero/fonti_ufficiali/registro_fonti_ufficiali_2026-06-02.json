      "source_ids": ["fatturapa_specifiche_formato", "agenzia_entrate_guida_fatturazione_elettronica"],
      "rule": "La fattura elettronica deve essere in formato XML FatturaPA e trasmessa tramite Sistema di Interscambio; un documento non XML o non transitato da SdI non è trattato come fattura elettronica emessa.",
      "software_modules": ["pct/fatturazione.py", "web/services/react_fatturazione_bridge.py", "frontend/src/components/FatturazionePage.tsx"],
      "tests": ["tests/test_fatturazione.py", "tests/test_react_fatturazione_bridge.py", "tests/test_fonti_ufficiali_registry.py"],
      "limits": ["IUSENTRA prepara e traccia XML/esiti; non sostituisce il portale o l'intermediario se il canale accreditato non è configurato."]
    },
    {
      "id": "fatturapa_sdi_esiti_monitoraggio",
      "source_ids": ["fatturapa_sdiftp_trasmissione", "fatturapa_sdicoop_trasmissione", "fatturapa_spcoop_trasmissione", "agenzia_entrate_guida_fatturazione_elettronica"],
      "rule": "Gli esiti SdI devono distinguere invio, consegna, impossibilità di recapito, scarto e decorrenza termini; lo scarto comporta correzione e nuovo invio, mentre consegna/impossibilità tracciano l'emissione secondo le regole SdI.",
