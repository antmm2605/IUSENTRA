      "negative_any": ["originale\\s+notificat[oa]", "ricevuta\\s+di\\s+accettazione", "ricevuta\\s+completa\\s+di\\s+avvenuta\\s+consegna", "ricevuta\\s+di\\s+avvenuta\\s+consegna", "prova\\s+di\\s+notifica\\s+depositata", "fac[- ]?simile"],
      "event_type": "notification_strategic_review",
      "confidence": 0.86,
      "reason": "Sentenza o provvedimento decisorio ricevuto: aprire presidio per valutare o preparare la notifica; la comunicazione di cancelleria non prova una notifica dell'avvocato.",
      "proposed_action": "Aprire presidio notifica sentenza: verificare destinatari, pubblici elenchi, relata separata, invio locale, RAC, RdAC completa e deposito prova.",
      "creates_notification_candidate": true,
      "human_review_required": true,
      "notification_case": "judgment_to_notify",
      "result_priority": "P1",
      "legal_sources": ["src.it.l53_1994.art3bis", "src.it.cpc.arts137_149", "src.it.cpc.art133", "src.it.cpc.art285", "src.it.cpc.art325", "src.it.cpc.art326", "src.it.cpc.art429"],
      "portal_original": "conditional"
    },
    {
      "id": "notif.detect.strategic_judgment.v1",
      "priority": 650,
      "source_types": ["message_body", "attachment"],
      "positive_any": ["sentenza.{0,180}(?:termine\\s+breve|art\\.?\\s*325|art\\.?\\s*326)"],
      "negative_any": ["mera\\s+comunicazione", "fac[- ]?simile"],
      "event_type": "notification_strategic_review",
      "confidence": 0.72,
      "reason": "La sentenza richiama profili compatibili con una valutazione sulla notifica e sul termine breve; non è una decisione automatica.",
      "proposed_action": "Creare revisione professionale senza far decorrere automaticamente termini.",
      "creates_notification_candidate": true,
      "human_review_required": true,
      "notification_case": "judgment_short_term_review",
      "result_priority": "P1",
      "legal_sources": ["src.it.l53_1994.art3bis", "src.it.cpc.arts137_149"],
      "portal_original": "conditional"
    },
    {
      "id": "notif.detect.sentenza_verbale_429_review.v1",
      "priority": 645,
      "source_types": ["message_body", "attachment"],
      "positive_any": [
        "sentenza\\s+a\\s+verbale",
