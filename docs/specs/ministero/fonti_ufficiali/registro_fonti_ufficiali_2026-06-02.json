      "source_ids": ["garante_registro_trattamenti", "garante_regolamento_ue_2016_679", "garante_testo_regolamento_ue_2016_679"],
      "rule": "Il registro delle attività di trattamento deve contenere finalità, categorie di interessati e dati, destinatari, termini di conservazione e misure di sicurezza; deve restare aggiornato e riflettere i trattamenti effettivi.",
      "software_modules": ["pct/privacy.py", "web/services/react_privacy_bridge.py", "frontend/src/components/PrivacyRegistroPage.tsx"],
