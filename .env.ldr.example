# Local Deep Research sidecar settings for IUSENTRA.
# Copy to .env.ldr and keep real credentials out of git.

# Host exposure for LDR web/API. Keep 127.0.0.1 unless an HTTPS/auth proxy
# protects the service.
LDR_BIND_ADDR=127.0.0.1
LDR_PORT=5000
LDR_APP_EXTERNAL_URL=http://localhost:5000

# Pick a model that the machine can actually run.
# Examples: gemma3:4b, llama3.1:8b, qwen2.5:7b, gpt-oss:20b.
LDR_LLM_MODEL=gemma3:4b

# Used only if SearXNG is exposed for local debugging.
SEARXNG_BASE_URL=http://localhost:8088/

# Optional credentials for the Python bridge client.
# Create this user from the LDR web UI first, then fill these values.
LDR_BASE_URL=http://local-deep-research:5000
LDR_USERNAME=
LDR_PASSWORD=
LDR_TIMEOUT_SECONDS=30

# Keep disabled unless an explicit studio policy allows a redacted/sensitive
# query to leave the tenant-aware Lex retrieval path.
LDR_ALLOW_SENSITIVE=0
