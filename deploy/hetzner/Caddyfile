{
	email {$ACME_EMAIL}
}

{$IUSENTRA_DOMAIN} {
	encode zstd gzip

	log {
		output file /var/log/iusentra/caddy-access.log {
			roll_size 50mb
			roll_keep 7
		}
		format json
	}

	request_body {
		max_size 200MB
	}

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	@default_permissions {
		not path /support/join/* /support/operatore/*
	}
	header @default_permissions Permissions-Policy "camera=(self), microphone=(self), local-network-access=(self), local-network=(self), loopback-network=(self), geolocation=()"

	# Rate limiting sulle route di autenticazione gestito da Flask-Limiter
	# con backend Redis (RATELIMIT_STORAGE_URI=redis://redis:6379/1).
	# Il modulo caddy-ratelimit non è incluso in caddy:2.8-alpine standard;
	# per aggiungere rate limiting a livello reverse proxy usare un'immagine
	# xcaddy custom oppure affidarsi al layer Flask (già operativo).

	# I file Vite dentro `assets` hanno un nome content-hash: possono restare
	# nella cache del browser per un anno senza rischio di servire codice vecchio.
	# La shell React e il manifest restano invece rivalidati, quindi puntano sempre
	# al bundle della versione distribuita più recente.
	@react_hashed_assets path /static/react/assets/*
	header @react_hashed_assets Cache-Control "public, max-age=31536000, immutable"

	@other_static {
		path /static/*
		not path /static/react/assets/*
	}
	header @other_static Cache-Control "public, max-age=604800"

	# La shell React usa rivalidazione condizionata con ETag: `no-cache` obbliga
	# comunque il browser a rivalidare prima di ogni uso, quindi non mostra mai
	# una pagina senza aver chiesto al server, mentre `private` la tiene fuori da
	# proxy e cache condivise. Con `no-store` il bordo annullerebbe i 304 che
	# l'applicazione emette, riscaricando l'intero documento ad ogni navigazione.
	@react_shell path /app-v2*
	header @react_shell Cache-Control "private, no-cache, must-revalidate, max-age=0"

	@support_rooms path /support/join/* /support/operatore/*
	header @support_rooms Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), local-network-access=(self), local-network=(self), loopback-network=(self), geolocation=(), payment=()"

	@sw path /sw.js /static/sw.js
	header @sw Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
	header @sw Service-Worker-Allowed "/"

	# SSE — timeout lungo, nessun buffering
	@sse path /api/eventi
	reverse_proxy @sse app:8080 {
		flush_interval -1
		transport http {
			read_timeout 1h
			write_timeout 1h
		}
	}

	# WebSocket supporto remoto
	@support_ws path /support/ws/*
	reverse_proxy @support_ws app:8080 {
		flush_interval -1
		transport http {
			read_timeout 1h
			write_timeout 1h
		}
	}

	reverse_proxy app:8080 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		health_uri /api/pronto
		health_interval 30s
		health_timeout 5s
	}
}
