{
  "name": "@iusentra/studio",
  "private": true,
  "version": "2.278.59",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "test": "node scripts/check-react-contracts.mjs && node scripts/check-notifiche-legali-presidi.mjs && node ../scripts/react-migration/audit-ui-preset-sequence.mjs && node ../scripts/react-migration/check-design-system-governance.mjs && node scripts/check-app-v2-frontend.mjs && node scripts/check-studio-voice-assistant.mjs && node scripts/check-legal-skills.mjs && python ../scripts/validate_ui_coverage.py",
    "test:notifiche-legali-presidi": "node scripts/check-notifiche-legali-presidi.mjs",
    "test:notifiche-legali-presidi:bundle": "node scripts/check-notifiche-legali-presidi-bundle.mjs",
    "test:notifiche-legali-presidi:full": "npm run test:notifiche-legali-presidi && npm run build:vite && npm run test:notifiche-legali-presidi:bundle",
    "test:app-v2": "node scripts/check-app-v2-frontend.mjs",
    "test:ui-coverage": "python ../scripts/validate_ui_coverage.py",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:vite": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "clean": "node -e \"const fs=require('node:fs'); for (const dir of ['dist','storybook-static']) fs.rmSync(dir,{recursive:true,force:true});\"",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0",
    "build-storybook": "storybook build --output-dir storybook-static",
    "chromatic": "chromatic --storybook-build-dir=storybook-static --exit-zero-on-changes",
    "chromatic:changed": "chromatic --only-changed --storybook-build-dir=storybook-static --exit-zero-on-changes"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.2.8",
    "@iusentra/ui": "workspace:*",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "postcss": "8.5.23",
    "radix-ui": "1.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "shadcn": "4.7.0",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "3.4.19",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "chromatic": "^16.10.1",
    "storybook": "^10.4.0"
  },
  "overrides": {
    "qs": "6.15.2",
    "@hono/node-server": "2.0.10",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.8",
    "fast-uri": "3.1.4",
    "hono": "4.12.27",
    "esbuild": "0.28.1",
    "vite": "6.4.3",
    "js-yaml": "4.3.0",
    "postcss": "8.5.23",
    "@babel/core": "7.29.7"
  }
}
