    {
      "id": "giustizia_map_competenza",
      "source_ids": ["giustizia_map"],
      "rule": "Giustizia Map serve per competenza territoriale e uffici per Comune; i codici deposito restano invece quelli dei cataloghi ministeriali PST o dei canali autonomi.",
