{
  "name": "@iusentra/studio",
  "private": true,
  "version": "2.278.86",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "test": "node scripts/check-react-contracts.mjs && node scripts/check-notifiche-legali-presidi.mjs && node ../scripts/react-migration/audit-ui-preset-sequence.mjs && node ../scripts/react-migration/check-design-system-governance.mjs && node scripts/check-app-v2-frontend.mjs && node scripts/check-studio-voice-assistant.mjs && node scripts/check-legal-skills.mjs && node scripts/check-storybook-page-coverage.mjs && python ../scripts/validate_ui_coverage.py",
    "test:notifiche-legali-presidi": "node scripts/check-notifiche-legali-presidi.mjs",
    "test:notifiche-legali-presidi:bundle": "node scripts/check-notifiche-legali-presidi-bundle.mjs",
    "test:notifiche-legali-presidi:full": "npm run test:notifiche-legali-presidi && npm run build:vite && npm run test:notifiche-legali-presidi:bundle",
    "test:app-v2": "node scripts/check-app-v2-frontend.mjs",
    "test:ui-coverage": "python ../scripts/validate_ui_coverage.py",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:vite": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "clean": "node -e \"const fs=require('node:fs'); for (const dir of ['dist','storybook-static']) fs.rmSync(dir,{recursive:true,force:true});\"",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0",
    "build-storybook": "storybook build --output-dir storybook-static",
    "test:storybook": "vitest run --project=storybook",
    "chromatic": "chromatic --storybook-build-dir=storybook-static --exit-zero-on-changes",
    "chromatic:changed": "chromatic --only-changed --storybook-build-dir=storybook-static --exit-zero-on-changes"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@iusentra/ui": "workspace:*",
    "@vitejs/plugin-react": "6.1.0",
    "autoprefixer": "10.5.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.33.0",
    "postcss": "8.5.26",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript/typescript6": "6.0.2",
    "@vitest/browser-playwright": "^4.1.11",
    "chromatic": "^18.5.0",
    "playwright": "^1.62.1",
    "storybook": "^10.5.10",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "qs": "6.15.2",
    "@hono/node-server": "2.0.10",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.8",
    "fast-uri": "3.1.4",
    "hono": "4.12.27",
    "esbuild": "0.28.1",
    "vite": "8.2.2",
    "js-yaml": "4.3.1",
    "postcss": "8.5.26",
    "@babel/core": "7.29.7"
  }
}
