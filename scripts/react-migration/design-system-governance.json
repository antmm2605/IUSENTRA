  "forbiddenCssPatterns": [
    {
      "id": "accento-laterale-spesso",
      "regex": "border-(left|right)\\s*:\\s*([2-9]|[1-9][0-9])px\\b",
      "reason": "Le card operative non devono usare accenti laterali pagina-specifici; usare bordo/superficie del preset."
    },
    {
      "id": "testo-gradiente",
      "regex": "background-clip\\s*:\\s*text|-webkit-text-fill-color",
      "reason": "Il gestionale usa gerarchie tipografiche istituzionali, non titoli decorativi."
    },
    {
      "id": "blur-decorativo",
      "regex": "(^|[^A-Za-z0-9_-])filter\\s*:\\s*blur\\(",
      "reason": "Orbi, bokeh e blur decorativi sono vietati nelle superfici operative."
    },
    {
      "id": "termini-decorativi",
      "regex": "\\b(orb|bokeh|glassmorphism)\\b",
      "reason": "La UI IUSENTRA deve restare operativa, non decorativa."
    }
