# IUSENTRA - ambiente produzione Hetzner
# Copiare in /opt/iusentra/.env.hetzner e compilare i valori vuoti.

# ── Rete e HTTPS ──────────────────────────────────────────────────────────────
IUSENTRA_DOMAIN=iusentra.tuodominio.it
ACME_EMAIL=admin@tuodominio.it
COMPOSE_PROFILES=audit-worm
PCT_PUBLIC_OUTBOUND_IP=

# ── Percorsi dati e storage ───────────────────────────────────────────────────
IUSENTRA_ENV_FILE=/opt/iusentra/.env.hetzner
IUSENTRA_DATA_DIR=/opt/iusentra/data
IUSENTRA_BACKUP_DIR=/opt/iusentra/backups
IUSENTRA_CADDY_DATA_DIR=/opt/iusentra/caddy_data
IUSENTRA_CADDY_CONFIG_DIR=/opt/iusentra/caddy_config

# ── Retention backup ──────────────────────────────────────────────────────────
# Valori di default governati — modificare solo se il volume dati lo richiede.
IUSENTRA_BACKUP_RETENTION_DAYS=14
IUSENTRA_BACKUP_RETENTION_COUNT=3
IUSENTRA_BACKUP_RETENTION_MIN_COUNT=2
IUSENTRA_BACKUP_RETENTION_MAX_GIB=8
IUSENTRA_BACKUP_ZSTD_LEVEL=19
IUSENTRA_BACKUP_ZSTD_LONG_WINDOW=27
# Percorsi rigenerabili esclusi dal backup (separati da virgola).
# Ollama e i download dei modelli sono rigenerabili e non devono consumare spazio backup.
IUSENTRA_BACKUP_EXCLUDE_PATHS=./ollama,./intelligence/downloads/ollama,./tenants/*/intelligence/downloads/ollama
# Cron schedule backup automatico (default: ogni giorno alle 02:15)
IUSENTRA_BACKUP_CRON_SCHEDULE=15 2 * * *

# ── Chiavi e segreti (NON committare valori reali) ────────────────────────────
PCT_SECRET_KEY=
PCT_DOC_KEY=
SECRET_KEY=
FERNET_PRIMARY_KEY=
AUDIT_HMAC_KEY=

# Audit probatorio WORM - valori reali obbligatori prima di abilitare emissioni in produzione.
AUDIT_ENABLED=true
AUDIT_ENV=production
AUDIT_REQUIRE_WORM=true
AUDIT_REQUIRE_SIGNATURE=true
AUDIT_REQUIRE_TSA_FOR_SNAPSHOT=true
AUDIT_RETENTION_YEARS=10
AUDIT_CANONICALIZATION=RFC8785-JCS
AUDIT_HASH_ALG=SHA-256
AUDIT_DATABASE_URL=
AUDIT_POSTGRES_DB=iusentra_audit
AUDIT_POSTGRES_USER=iusentra_audit
AUDIT_POSTGRES_PASSWORD=
AUDIT_WORM_ENDPOINT_URL=http://audit-worm:9000
AUDIT_WORM_REGION=eu-central-1
AUDIT_WORM_BUCKET=
AUDIT_WORM_ACCESS_KEY=
AUDIT_WORM_SECRET_KEY=
AUDIT_WORM_RETENTION_YEARS=10
AUDIT_WORM_MODE=COMPLIANCE
AUDIT_WORM_REQUIRE_OBJECT_LOCK=true
AUDIT_SIGNING_MODE=CADES
AUDIT_SIGNING_KID=
AUDIT_SIGNING_KEY_SOURCE=HSM
AUDIT_SIGNING_KEY_SEALED=
AUDIT_SIGNING_CERT_FINGERPRINT=
AUDIT_CADES_LOCAL_SIGNER_URL=
AUDIT_CADES_VERIFY_URL=
AUDIT_TSA_URL=
AUDIT_TSA_USERNAME=
AUDIT_TSA_PASSWORD=
AUDIT_INTERNAL_RATE_LIMIT_PER_MINUTE=60

# ── Configurazione studio ─────────────────────────────────────────────────────
PCT_STUDIO_NOME=IUSENTRA
FLASK_ENV=production
PCT_HTTPS=true
PCT_MULTI_TENANT=1
PCT_STORAGE_MODE=SQLITE
PCT_SQLITE_MODE=1
DATABASE_URL=sqlite:////data/iusentra.sqlite
PCT_PRACTICE_ENGINE_DB=/data/fascicoli/practice_engine/practice_engine.json
PCT_TIMESHEET_DB=/data/timesheet/entries.json
PCT_NOTIFICATIONS_DB=/data/notifications/notifications.db
IUSENTRA_EMAIL_ATTACHMENT_STORAGE=archive
IUSENTRA_LEGAL_UPDATES_ITEM_TIMEOUT_SECONDS=180
IUSENTRA_LEGAL_UPDATES_PUBLISH_MAX_ITEMS=80

# Notifiche PWA su mobile/tablet. Le chiavi VAPID reali vanno generate fuori repo.
IUSENTRA_WEB_PUSH_ENABLED=0
IUSENTRA_VAPID_PUBLIC_KEY=
IUSENTRA_VAPID_PRIVATE_KEY=
IUSENTRA_VAPID_SUBJECT=mailto:admin@example.com

# Feature flag React/App V2, default off.
IUSENTRA_FEATURE_FLAGS={}
IUSENTRA_FF_ROUTES_APPV2_DOCS_PANEL=0
IUSENTRA_FF_ROUTES_APPV2_COMMS_DEPOSITS=0
IUSENTRA_FF_ROUTES_APPV2_UPLOAD_CLASSIFICATION=0
IUSENTRA_FF_ROUTES_APPV2_DEADLINES=0
IUSENTRA_FF_ROUTES_APPV2_AGENDA=0
IUSENTRA_FF_ROUTES_APPV2_CASE_FILES=0
IUSENTRA_FF_NOTIFICATIONS_MOBILE_PUSH=0

# ── Redis e rate limiting ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
RATELIMIT_STORAGE_URI=redis://redis:6379/1
PROMETHEUS_ENABLED=1

# ── Worker e concorrenza ──────────────────────────────────────────────────────
WEB_CONCURRENCY=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=1800
PCT_OCR_WORKERS=2

# ── AI locale (Ollama) ────────────────────────────────────────────────────────
# Ollama è un servizio opzionale con profilo Docker `ai`.
#
# Per abilitare l'AI locale (sidecar Docker):
#   COMPOSE_PROFILES=ai
#   PCT_LOCAL_AI_ENABLED=1
#   PCT_LOCAL_AI_BASE_URL=http://ollama:11434/api
#
# Per disabilitare completamente l'AI locale:
#   COMPOSE_PROFILES=
#   PCT_LOCAL_AI_ENABLED=0
#
# Per usare Ollama installato sull'host (fuori Docker):
#   COMPOSE_PROFILES=
#   PCT_LOCAL_AI_ENABLED=1
#   PCT_LOCAL_AI_BASE_URL=http://host.docker.internal:11434/api
#
COMPOSE_PROFILES=ai
PCT_LOCAL_AI_ENABLED=1
PCT_LOCAL_AI_BASE_URL=http://ollama:11434/api
PCT_LOCAL_AI_CHAT_MODEL=gemma3:1b

# ── Unlimited-OCR self-hosted ───────────────────────────────────────────────
# Motore OCR opzionale e isolato per PDF scansionati/lunghi.
# Richiede un host con acceleratore supportato da SGLang; non gira dentro l'app.
#
# Per abilitare anche il sidecar Unlimited-OCR:
#   COMPOSE_PROFILES=ai,unlimited-ocr
#   IUSENTRA_UNLIMITED_OCR_ENABLED=1
#   IUSENTRA_UNLIMITED_OCR_ENDPOINT=http://unlimited-ocr:10000
#
# Su host senza GPU lasciare ENABLED=0: IUSENTRA usa il fallback corrente e non
# registra risultati come Unlimited-OCR.
IUSENTRA_UNLIMITED_OCR_ENABLED=0
IUSENTRA_UNLIMITED_OCR_ENDPOINT=http://unlimited-ocr:10000
IUSENTRA_UNLIMITED_OCR_MODEL=Unlimited-OCR
IUSENTRA_UNLIMITED_OCR_PROVIDER=self_hosted
IUSENTRA_UNLIMITED_OCR_TIMEOUT_SECONDS=300
IUSENTRA_UNLIMITED_OCR_CONCURRENCY=2
IUSENTRA_UNLIMITED_OCR_MAX_PAGES=48
IUSENTRA_UNLIMITED_OCR_STREAM=1
IUSENTRA_UNLIMITED_OCR_MODEL_DIR=baidu/Unlimited-OCR
IUSENTRA_UNLIMITED_OCR_IMAGE=lmsysorg/sglang:latest
